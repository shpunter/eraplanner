# URLs of the microfrontend remotes' Module Federation entries.
# Point each at the deployed remote's `remoteEntry.js`, e.g.
#   VITE_LAW_REMOTE_ENTRY=https://law.eraplanner.com/remoteEntry.js
#   VITE_MINES_REMOTE_ENTRY=https://mines.eraplanner.com/remoteEntry.js
#   VITE_RESOURCES_REMOTE_ENTRY=https://resources.eraplanner.com/remoteEntry.js
# Leave unset (or point at localhost for dev) to use each tab's fallback.
VITE_LAW_REMOTE_ENTRY=https://law.eraplanner.com/remoteEntry.js
VITE_MINES_REMOTE_ENTRY=https://mines.eraplanner.com/remoteEntry.js
VITE_RESOURCES_REMOTE_ENTRY=https://resources.eraplanner.com/remoteEntry.js
